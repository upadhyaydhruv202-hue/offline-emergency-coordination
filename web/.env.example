# Copy to `.env.local` for local overrides. Only VITE_* variables reach the browser,
# so never put a secret in this file.

# Base URL of the coordination backend, including the version prefix.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Label shown in the command-centre header.
VITE_COMMAND_CENTRE_NAME=State EOC — Gandhinagar
