# Root environment file, consumed by docker-compose.yml.
# Copy to `.env` and set real values. Never commit `.env`.

# --- PostgreSQL / PostGIS --------------------------------------------------
POSTGRES_DB=drp
POSTGRES_USER=drp_app
# Required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# --- API container ---------------------------------------------------------
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Required when ENVIRONMENT is staging or production (min 32 chars).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Password applied to the demo accounts created by `python -m app.db.seed`.
# Leave blank to have one generated and printed once.
SEED_PASSWORD=
