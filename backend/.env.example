# Copy to `.env` and fill in real values. Never commit `.env`.

# --- Application -----------------------------------------------------------
APP_NAME="Disaster Response Platform API"
ENVIRONMENT=development          # development | test | staging | production
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1

# --- Database --------------------------------------------------------------
# PostgreSQL + PostGIS (matches docker-compose.yml).
DATABASE_URL=postgresql+psycopg://drp_app:CHANGE_ME@localhost:5432/drp
DATABASE_ECHO=false

# Local development without Docker can fall back to SQLite:
# DATABASE_URL=sqlite+pysqlite:///./drp_dev.sqlite3

# --- Security --------------------------------------------------------------
# Required unless ENVIRONMENT is development/test.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Seed data -------------------------------------------------------------
# Password applied to every demo account by `python -m app.db.seed`.
# Leave blank to have one generated and printed once.
SEED_PASSWORD=
